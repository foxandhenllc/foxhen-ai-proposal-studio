{
  "name": "foxhen-ai-proposal-studio",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:smoke",
    "test:smoke": "rm -rf .smoke-build && tsc -p tsconfig.smoke.json && node .smoke-build/tests/proposal-export.smoke.js",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.14",
    "typescript": "5.7.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Use this repo to structure scoping, assumptions, exclusions, timelines, risk flags, estimate bands, and prompt-pack exports.",
  "keywords": [
    "assumptions",
    "builder",
    "exclusions",
    "fox-and-hen",
    "freelance",
    "generator",
    "proposal",
    "scope",
    "small-business",
    "structured",
    "studio",
    "tool",
    "workflow-tools"
  ],
  "license": "MIT"
}
